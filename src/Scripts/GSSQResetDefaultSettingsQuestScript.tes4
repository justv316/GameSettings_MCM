			endif
			if iPhase == 9
				Message "ConsoleCommand SetGameSetting fSneakSkillMult 0.5"
				Message "ConsoleCommand SetGameSetting fSneakBootWeightBase 14"
				Message "ConsoleCommand SetGameSetting fSneakBootWeightMult 1"
				Message "ConsoleCommand SetGameSetting fSneakRunningMult 1.3"
				Message "ConsoleCommand SetGameSetting fSneakSleepBonus -10.0"
				Message "ConsoleCommand SetGameSetting fSneakSoundLosMult 1.0"
				Message "ConsoleCommand SetGameSetting fSneakSoundsMult 1.60"
				Message "ConsoleCommand SetGameSetting fSneakSwimmingLightMult 0.50"
				Message "ConsoleCommand SetGameSetting fSneakTargetAttackBonus 100.0"
				Message "ConsoleCommand SetGameSetting fSneakTargetInCombatBonus 25.0"
				Message "ConsoleCommand SetGameSetting iAICombatMinDetection -50"
				Message "ConsoleCommand SetGameSetting fDetectionTimerSetting 0.30"
				set iPhase to iPhase + 1
			endif
			if iPhase == 10
				Message "ConsoleCommand SetGameSetting fDetectionSneakLightMod -5.0"
				Message "ConsoleCommand SetGameSetting fDetectionNightEyeBonus 3.0"
				Message "ConsoleCommand SetGameSetting fCrimeDispAttack -10.0"
				Message "ConsoleCommand SetGameSetting fCrimeDispMurder -50"
				Message "ConsoleCommand SetGameSetting fCrimeDispPickpocket -25"
				Message "ConsoleCommand SetGameSetting fCrimeDispSteal -0.5"
				Message "ConsoleCommand SetGameSetting fCrimeDispTresspass -20.0"
				Message "ConsoleCommand SetGameSetting fCrimeDispPersonal 2.0"
				Message "ConsoleCommand SetGameSetting fCrimeGoldSteal 0.5"
				Message "ConsoleCommand SetGameSetting iCrimeGoldAttackMin 500"
				Message "ConsoleCommand SetGameSetting iCrimeGoldAttack 40"
				Message "ConsoleCommand SetGameSetting iCrimeGoldJailBreak 50"
				set iPhase to iPhase + 1
			endif
			if iPhase == 11
				Message "ConsoleCommand SetGameSetting iCrimeGoldMurder 1000"
				Message "ConsoleCommand SetGameSetting iCrimeGoldPickpocket 25"
				Message "ConsoleCommand SetGameSetting iCrimeGoldStealHorse 250"
				Message "ConsoleCommand SetGameSetting iCrimeGoldTresspass 5"
				Message "ConsoleCommand SetGameSetting iCrimeGoldMinValue 50"
				Message "ConsoleCommand SetGameSetting iCrimeAlarmRecDistance 4000"
				Message "ConsoleCommand SetGameSetting iNumberGuardsCrimeResponse 4"
				Message "ConsoleCommand SetGameSetting iCrimeDaysInPrisonMod 100"
				Message "ConsoleCommand SetGameSetting fLockPickAutoBase 45.0"
				Message "ConsoleCommand SetGameSetting iLockLevelMaxVeryEasy 7"
				Message "ConsoleCommand SetGameSetting iLockLevelMaxEasy 20"
				Message "ConsoleCommand SetGameSetting iLockLevelMaxAverage 40"
				set iPhase to iPhase + 1
			endif
			if iPhase == 12
				Message "ConsoleCommand SetGameSetting ffMagicCostScale"
				Message "ConsoleCommand SetGameSetting ffMagicAreaBaseCostMult"
				Message "ConsoleCommand SetGameSetting ffMagicDurMagBaseCostMult"
				Message "ConsoleCommand SetGameSetting ffMagicRangeTargetCostMult"
				Message "ConsoleCommand SetGameSetting ffMagicCasterSkillCostBase"
				Message "ConsoleCommand SetGameSetting ffMagicCasterSkillCostMult"
				Message "ConsoleCommand SetGameSetting ffSpellmakingGoldMult"
				Message "ConsoleCommand SetGameSetting ffMagicCEEnchantMagOffset"
				Message "ConsoleCommand SetGameSetting ffEnchantmentGoldMult"
				Message "ConsoleCommand SetGameSetting ffEnchantmentPointsMult"
				Message "ConsoleCommand SetGameSetting ffRechargeGoldMult"
				Message "ConsoleCommand SetGameSetting fiSoulLevelValuePetty"
				set iPhase to iPhase + 1
			endif
			if iPhase == 13
				Message "ConsoleCommand SetGameSetting fPickPocketMaxChance 85.0"
				Message "ConsoleCommand SetGameSetting fPickPocketMinChance 5."
				Message "ConsoleCommand SetGameSetting ffEnchantPettyLimit"
				Message "ConsoleCommand SetGameSetting fiSoulLevelValueLesser"
				Message "ConsoleCommand SetGameSetting ffEnchantLesserLimit"
				Message "ConsoleCommand SetGameSetting fiSoulLevelValueCommon"
				Message "ConsoleCommand SetGameSetting ffEnchantCommonLimit"
				Message "ConsoleCommand SetGameSetting fiSoulLevelValueGreater"
				Message "ConsoleCommand SetGameSetting ffEnchantGreaterLimit"
				Message "ConsoleCommand SetGameSetting fiSoulLevelValueGrand"
				Message "ConsoleCommand SetGameSetting ffEnchantGrandLimit"
				Message "ConsoleCommand SetGameSetting ffMagicSpellLevelApprenticeMin"
				set iPhase to iPhase + 1
			endif
			if iPhase == 14
				Message "ConsoleCommand SetGameSetting ffMagicSpellLevelJourneymanMin"
				Message "ConsoleCommand SetGameSetting ffMagicSpellLevelExpertMin"
				Message "ConsoleCommand SetGameSetting ffMagicSpellLevelMasterMin"
				Message "ConsoleCommand SetGameSetting ffMagicDiseaseTransferBase"
				Message "ConsoleCommand SetGameSetting ffMagicDiseaseTransferMult"
				Message "ConsoleCommand SetGameSetting ffMagicSunDamageSunHiddenScale"
				Message "ConsoleCommand SetGameSetting ffMagicSunDamageWaterScale"
				Message "ConsoleCommand SetGameSetting ffMagicLightForwardOffset"
				Message "ConsoleCommand SetGameSetting ffMagicLightHeightOffset"
				Message "ConsoleCommand SetGameSetting ffMagicLightHeightOffset"
				Message "ConsoleCommand SetGameSetting ffMagicNightEyeAmbient"
				Message "ConsoleCommand SetGameSetting ffChameleonMaxRefraction"
				set iPhase to iPhase + 1
			endif
			if iPhase == 15
				Message "ConsoleCommand SetGameSetting ffChameleonMinRefraction"
				Message "ConsoleCommand SetGameSetting ffShockCastVOffset"
				Message "ConsoleCommand SetGameSetting ffShockBoltsRadius"
				Message "ConsoleCommand SetGameSetting ffMagicLevelMagnitudeMult"
				Message "ConsoleCommand SetGameSetting fiMagnitudeLevelAffectsAll"
				Message "ConsoleCommand SetGameSetting ffMagicUnitsPerFoot"
				Message "ConsoleCommand SetGameSetting fiMaxPlayerSummonedCreatures"
				set iPhase to iPhase + 1
			endif
			if iPhase == 16
				EnablePlayerControls
				set GSbResetDefaultSettings to 0
				MessageBox "Default Settings have been restored."
			endif
		endif
	endif
end

				
				
